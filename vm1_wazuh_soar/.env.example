# Wazuh Configuration
WAZUH_VERSION=4.9.0

# Wazuh Credentials (SEPARATE for each component - DO NOT reuse passwords)
# Indexer (OpenSearch) credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_INDEXER_PASSWORD

# Manager API credentials
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME_API_PASSWORD

# Dashboard credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD

# Network Configuration
VM1_IP=<VM1_PRIVATE_IP>
VM2_IP=<VM2_PRIVATE_IP>
TARGET_IP=<TARGET_ENDPOINT_IP>
ATTACKER_IP=<ATTACKER_MACHINE_IP>

# n8n Configuration
N8N_WEBHOOK_URL=http://<VM1_PUBLIC_IP>:5678/webhook/soc-alert
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

# Splunk Configuration (VM2)
SPLUNK_PASSWORD=CHANGE_ME_SPLUNK_PASSWORD

# External API Keys (configure in n8n credentials, not here)
VIRUSTOTAL_API_KEY=
SLACK_WEBHOOK_URL=